__pycache__/
*.pyc
*.pyo
.DS_Store
*.egg-info/
dist/
build/
.env

# Local TLS material — per-machine, never committed.
# The proxy CA (caido_ca.crt) is public, but it is specific to one Caido
# install; the broad rules below are what keep a private key from slipping in.
*.crt
*.pem
*.key
*.der
*.p12
*.pfx
